---
import { checkModernFormats, getAvifPath, getWebpPath, getOptimizedSrc } from '@/utils/imageHelpers';

interface Props {
  images: {
    url: string;
    alt: string;
  }[];
}

const { images } = Astro.props;

const processedImages = images.map(img => {
  const { avifExists, webpExists } = checkModernFormats(img.url);
  return {
    ...img,
    shouldUsePicture: avifExists && webpExists,
    optimizedSrc: getOptimizedSrc(img.url),
  };
});

const pad = (n: number) => String(n).padStart(2, '0');
---

<!-- Square tiles on a 2px grid, rotating the Mosaic tile shades; the full image opens in the dialog below -->
<ul class="grid grid-cols-2 gap-[2px] sm:grid-cols-3 lg:grid-cols-4">
  {processedImages.map((img, i) => (
    <li class="bg-tile [&:nth-child(4n+2)]:bg-tile-2 [&:nth-child(5n+3)]:bg-tile-3">
      <button
        type="button"
        class="group relative block aspect-square w-full overflow-hidden text-left"
        data-gallery-item
        data-index={`${pad(i + 1)} / ${pad(images.length)}`}
        data-caption={img.alt}
      >
        {img.shouldUsePicture ? (
          <picture>
            <source type="image/avif" srcset={getAvifPath(img.url)} />
            <source type="image/webp" srcset={getWebpPath(img.url)} />
            <img src={img.optimizedSrc} alt={img.alt} loading="lazy" class="h-full w-full object-cover"/>
          </picture>
        ) : (
          <img src={img.optimizedSrc} alt={img.alt} loading="lazy" class="h-full w-full object-cover"/>
        )}
        <span class="absolute inset-x-0 bottom-0 flex gap-3 bg-black px-3 py-2 text-xs text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
          <span class="font-mono shrink-0 text-neutral-500">{pad(i + 1)}</span>
          <span class="line-clamp-2">{img.alt}</span>
        </span>
      </button>
    </li>
  ))}
</ul>

<dialog id="gallery-dialog" class="m-auto max-h-none max-w-none bg-transparent p-4 text-neutral-200 backdrop:bg-black/90">
  <figure class="flex flex-col gap-3">
    <img alt="" class="max-h-[80vh] w-auto max-w-[90vw] object-contain"/>
    <figcaption class="flex items-baseline gap-4 text-sm">
      <span class="font-mono shrink-0 text-xs uppercase tracking-wide text-neutral-500" data-index></span>
      <span class="text-neutral-300" data-caption></span>
      <button type="button" class="font-mono ml-auto shrink-0 text-xs uppercase tracking-wide text-neutral-500 hover:text-white focus-visible:text-white" data-close>Esc / Close</button>
    </figcaption>
  </figure>
</dialog>

<script>
  // Delegated on document because ClientRouter runs this once per session; Esc closing comes free with <dialog>
  document.addEventListener('click', (e) => {
    const dialog = document.getElementById('gallery-dialog') as HTMLDialogElement | null;
    if (!dialog || !(e.target instanceof Element)) return;

    // Clicks on the backdrop land on the dialog itself
    if (e.target === dialog || e.target.closest('[data-close]')) return dialog.close();

    const item = e.target.closest<HTMLElement>('[data-gallery-item]');
    if (!item) return;
    const thumb = item.querySelector('img')!;
    const full = dialog.querySelector('img')!;
    full.src = thumb.currentSrc || thumb.src;
    full.alt = thumb.alt;
    dialog.querySelector('[data-index]')!.textContent = item.dataset.index ?? '';
    dialog.querySelector('[data-caption]')!.textContent = item.dataset.caption ?? '';
    dialog.showModal();
  });
</script>
