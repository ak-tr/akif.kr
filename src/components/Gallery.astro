---
import Picture from './Picture.astro';
import { tileSize } from '@/utils/tileSize';

interface Props {
  images: {
    url: string;
    /** Shown as the caption; captionless photos get a numbered alt */
    alt?: string;
  }[];
  /** Big and small squares like Mosaic, instead of uniform squares */
  tiles?: boolean;
}

const { images, tiles = false } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');

const processedImages = images.map((img, i) => ({
  ...img,
  caption: img.alt,
  alt: img.alt ?? `Photo ${pad(i + 1)} of ${pad(images.length)}`,
}));
---

<!-- Square tiles on a 2px grid, rotating the Mosaic tile shades; the full image opens in the dialog below -->
<ul class:list={["grid gap-[2px]", tiles ? "tiles" : "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4"]}>
  {processedImages.map((img, i) => (
    <li class:list={["aspect-square bg-tile [&:nth-child(4n+2)]:bg-tile-2 [&:nth-child(5n+3)]:bg-tile-3", tiles && tileSize(i, images.length)]}>
      <button
        type="button"
        class="group relative block h-full w-full overflow-hidden text-left outline-none"
        data-gallery-item
        data-index={`${pad(i + 1)} / ${pad(images.length)}`}
        data-caption={img.caption}
      >
        <Picture src={img.url} alt={img.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover"/>
        <!-- Slides up from the bottom edge on hover or keyboard focus; captionless photos show their index -->
        <span class="absolute inset-x-0 bottom-0 flex translate-y-full gap-3 bg-black px-3 py-2 text-xs text-white transition-transform duration-300 motion-reduce:transition-none can-hover:group-hover:translate-y-0 group-focus-visible:translate-y-0">
          <span class="font-mono shrink-0 text-neutral-500">{img.caption ? pad(i + 1) : `${pad(i + 1)} / ${pad(images.length)}`}</span>
          {img.caption && <span class="line-clamp-2">{img.caption}</span>}
        </span>
      </button>
    </li>
  ))}
</ul>

<style>
  /* Tile sizes mirror Mosaic.astro; images are absolute so photos never stretch a row */
  .tiles { grid-template-columns: repeat(3, 1fr); grid-auto-flow: dense; }
  .tiles > .big { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  .tiles > .big.right { grid-column: 2 / span 2; }
  .tiles > .wide-2 { grid-column: span 2; aspect-ratio: auto; }
  .tiles > .wide-3 { grid-column: span 3; aspect-ratio: auto; min-height: 260px; }

  @media (max-width: 720px) {
    .tiles { grid-template-columns: 1fr 1fr; }
    .tiles > .big, .tiles > .big.right, .tiles > .wide-3 { grid-column: span 2; aspect-ratio: 1; min-height: 0; }
    .tiles > .wide-2 { grid-column: auto; aspect-ratio: 1; }
  }
</style>

<dialog id="gallery-dialog" class="m-auto max-h-none max-w-none overflow-visible bg-transparent p-4 text-neutral-200 backdrop:bg-black/90">
  <figure class="flex flex-col gap-3">
    <img alt="" class="max-h-[80vh] w-auto max-w-[90vw] object-contain"/>
    <figcaption class="flex items-baseline gap-4 text-sm">
      <span class="font-mono shrink-0 text-xs uppercase tracking-wide text-neutral-500" data-index></span>
      <span class="text-neutral-300" data-caption></span>
      <button type="button" class="font-mono ml-auto shrink-0 text-xs uppercase tracking-wide text-neutral-500 outline-none hover:text-white focus-visible:text-white" data-close><span class="hidden can-hover:inline">Esc / </span>Close</button>
    </figcaption>
  </figure>
</dialog>

<script>
  // Delegated on document because ClientRouter runs this once per session
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const timing = { duration: 420, easing: 'cubic-bezier(.2, .8, .2, 1)' };
  let from: HTMLElement | null = null; // the tile the open photo grew out of
  let closing = false;

  const isGalleryDialog = (t: EventTarget | null): t is HTMLDialogElement => t instanceof HTMLDialogElement && t.id === 'gallery-dialog';

  const rest = { transform: 'none', clipPath: 'inset(0px 0px)' };

  // The full photo scaled and clipped to exactly cover its tile, as object-fit: cover does
  function inTile(full: HTMLImageElement, tile: HTMLElement) {
    const t = tile.getBoundingClientRect(), f = full.getBoundingClientRect();
    const s = Math.max(t.width / f.width, t.height / f.height);
    const x = t.left + t.width / 2 - (f.left + f.width / 2), y = t.top + t.height / 2 - (f.top + f.height / 2);
    const ix = (f.width - t.width / s) / 2, iy = (f.height - t.height / s) / 2;
    return { transform: `translate(${x}px, ${y}px) scale(${s})`, clipPath: `inset(${iy}px ${ix}px)` };
  }

  async function open(dialog: HTMLDialogElement, item: HTMLElement) {
    const thumb = item.querySelector('img')!;
    const full = dialog.querySelector('img')!;
    full.src = thumb.currentSrc || thumb.src;
    full.alt = thumb.alt;
    dialog.querySelector('[data-index]')!.textContent = item.dataset.index ?? '';
    dialog.querySelector('[data-caption]')!.textContent = item.dataset.caption ?? '';
    // Decode first, then open and animate in the same frame, so the photo never paints at full size before it grows
    await full.decode().catch(() => {});
    dialog.showModal();
    if (still.matches) return;
    from = item;
    thumb.style.visibility = 'hidden';
    // Hold the start inline too: some browsers paint a frame before the animation applies, which flashed the photo at full size
    const start = inTile(full, item);
    Object.assign(full.style, start);
    full.animate([start, rest], timing).finished.catch(() => {}).then(() => {
      full.style.removeProperty('transform');
      full.style.removeProperty('clip-path');
    });
    dialog.animate({ opacity: [0, 1] }, { ...timing, pseudoElement: '::backdrop' });
    dialog.querySelector('figcaption')!.animate({ opacity: [0, 1] }, { duration: 200, delay: 300, fill: 'backwards' });
  }

  async function close(dialog: HTMLDialogElement) {
    if (closing) return;
    if (from) {
      closing = true;
      const full = dialog.querySelector('img')!;
      const back = { duration: 340, easing: 'cubic-bezier(.4, 0, .2, 1)', fill: 'forwards' as const };
      dialog.querySelector('figcaption')!.animate({ opacity: [1, 0] }, { duration: 120, fill: 'forwards' });
      dialog.animate({ opacity: [1, 0] }, { ...back, pseudoElement: '::backdrop' });
      await full.animate([rest, inTile(full, from)], back).finished.catch(() => {});
    }
    dialog.close();
  }

  document.addEventListener('click', (e) => {
    const dialog = document.getElementById('gallery-dialog') as HTMLDialogElement | null;
    if (!dialog || !(e.target instanceof Element)) return;

    // Clicks on the backdrop land on the dialog itself
    if (e.target === dialog || e.target.closest('[data-close]')) return close(dialog);

    const item = e.target.closest<HTMLElement>('[data-gallery-item]');
    if (item) open(dialog, item);
  });

  // cancel and close don't bubble, so listen in the capture phase. Esc shrinks the photo back like Close does
  document.addEventListener('cancel', (e) => {
    if (!isGalleryDialog(e.target)) return;
    e.preventDefault();
    close(e.target);
  }, true);

  // However it closed (a second Esc can skip cancel), put the tile back and drop the animations
  document.addEventListener('close', (e) => {
    if (!isGalleryDialog(e.target)) return;
    e.target.getAnimations({ subtree: true }).forEach((a) => a.cancel());
    from?.querySelector('img')!.style.removeProperty('visibility');
    from = null;
    closing = false;
  }, true);
</script>
