---
import SocialIcon from '@/components/social-icons/index.astro'
import { SITE_METADATA } from '@/consts'
---

<footer class="font-mono mt-24 flex flex-col-reverse items-start gap-4 border-t border-neutral-900 py-8 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {SITE_METADATA.author} / <a href="/" class="hover:text-white">{SITE_METADATA.title}</a></p>
    <div class="flex gap-4">
        <SocialIcon kind="mail" href={`mailto:${SITE_METADATA.email}`} size={5}/>
        <SocialIcon kind="github" href={SITE_METADATA.github} size={5}/>
        <SocialIcon kind="linkedin" href={SITE_METADATA.linkedin} size={5}/>
    </div>
</footer>
