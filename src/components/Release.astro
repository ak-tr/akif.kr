---
interface Props {
    repo: string; // GitHub "owner/name"
    tag?: string; // read at build time, shown until the browser has a newer one
}

const { repo, tag } = Astro.props;
---
<span data-release={repo.split("/")[1]}>{tag ?? "latest"}</span>

<!--
    Inline so the last tag this browser saw is in place before the first paint, then refreshed in the background.
    The endpoint is functions/api/releases/[repo].ts, cached at the edge. data-astro-rerun runs it again after ClientRouter navigations.
-->
<script is:inline data-astro-rerun>
    (() => {
        const el = document.currentScript.previousElementSibling, key = `release:${el.dataset.release}`;
        try { el.textContent = localStorage.getItem(key) || el.textContent; } catch {}
        fetch(`/api/releases/${el.dataset.release}`)
            .then((res) => res.ok && res.json())
            .then((data) => {
                if (!data?.tag) return;
                el.textContent = data.tag;
                try { localStorage.setItem(key, data.tag); } catch {}
            })
            .catch(() => {});
    })();
</script>
