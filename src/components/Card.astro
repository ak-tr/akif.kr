---
interface Props {
    title: string;
    description: string[];
    link?: {
        text: string;
        href: string;
    };
}

const { title, description, link } = Astro.props;
---

<div class="not-prose flex flex-col gap-1 mt-12 border border-neutral-800 p-6 bg-[#111]">
  <h3 class="text-lg font-semibold text-white mb-2">
    {title}
  </h3>
  {description.map((desc) => (
    <p class="text-neutral-400">
      {desc}
    </p>
  ))}
  {link && (
    <div class="mt-4">
      <a
        href={link.href}
        class="font-mono inline-block text-xs uppercase tracking-wide text-white underline decoration-neutral-600 underline-offset-4 hover:decoration-white"
        target="_blank"
        rel="noopener noreferrer"
      >
        {link.text}
      </a>
    </div>
  )}
</div>
