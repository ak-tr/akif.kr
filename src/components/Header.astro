---
import { SITE_METADATA, NAVIGATION } from '@/consts';
import HeaderLink from './HeaderLink.astro';
import MobileNav from "./MobileNav.astro";
---

<header class="flex items-center gap-7 py-7 text-sm sm:py-10">
    <a href="/" class="group relative mr-auto text-lg font-bold text-white" aria-label={SITE_METADATA.headerTitle}>
        <span class="transition-opacity duration-200 group-hover:opacity-0 group-focus-visible:opacity-0">{SITE_METADATA.headerTitle}</span>
        <!-- Wordmark swaps to the Mosaic logo on hover; the text keeps its space so nothing shifts -->
        <img src="/static/brand/logo-mosaic.svg" alt="" width="28" height="28"
             class="pointer-events-none absolute left-1/2 top-1/2 h-7 w-7 -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"/>
    </a>
    {NAVIGATION
        .filter((link) => link.href !== '/')
        .map((link) => (
            <HeaderLink href={link.href} class="hidden text-neutral-500 transition-colors hover:text-white sm:block [&.active]:text-white">
                {link.title}
            </HeaderLink>
        ))
    }
    <!-- Phones have no ⌘K, so they get a search button next to the menu -->
    <button type="button" data-search-open aria-label="Search" class="sm:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6 text-white">
            <circle cx="8.5" cy="8.5" r="5.5"/>
            <path d="M12.5 12.5 17 17" stroke-linecap="square"/>
        </svg>
    </button>
    <MobileNav/>
</header>
