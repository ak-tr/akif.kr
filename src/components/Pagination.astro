---
import type { Page } from "astro";

type Props = {
    page: Page,
};

const {
    page: {
        currentPage,
        lastPage,
        url: {
            prev,
            next
        }
    }
} = Astro.props;
---

<nav class="font-mono flex justify-between border-t border-neutral-900 pt-6 mt-10 text-xs uppercase tracking-wide text-neutral-500">
    {prev ? <a href={prev} rel="prev" class="hover:text-white">← Newer</a> : <span class="opacity-40">← Newer</span>}
    <span>{currentPage} / {lastPage}</span>
    {next ? <a href={next} rel="next" class="hover:text-white">Older →</a> : <span class="opacity-40">Older →</span>}
</nav>
