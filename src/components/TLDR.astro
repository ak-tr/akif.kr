---
interface Props {
  fix?: string; // anchor for the "jump" link, set to "" to hide it
  label?: string;
}

const { fix = "#the-fix", label = "TL;DR" } = Astro.props;
---

<aside aria-label={label} class="not-prose my-6 border border-neutral-800 bg-tile">
  <div class="flex items-center justify-between border-b border-neutral-800 bg-tile-3 px-4 py-2.5">
    <span class="font-mono text-xs uppercase tracking-wide text-white">{label}</span>
    {fix && <a href={fix} class="font-mono text-xs uppercase tracking-wide text-white underline decoration-neutral-600 underline-offset-4 hover:decoration-white">Jump to the fix →</a>}
  </div>
  <dl class="grid grid-cols-1 gap-x-4 gap-y-1 px-4 py-3.5 text-neutral-300 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-y-3 [&_code]:font-mono [&_code]:text-sm [&_code]:text-white">
    <slot />
  </dl>
</aside>
