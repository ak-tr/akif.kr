---
import Link from "./Link.astro";
import {type CollectionEntry, getEntry} from "astro:content";

interface Props {
    tag?: CollectionEntry<'tags'>;
    slug?: CollectionEntry<'tags'>['id'];
    chip?: boolean;
}

let tag = Astro.props.tag;

if (!tag && Astro.props.slug) {
    tag = await getEntry('tags', Astro.props.slug);
}

const slug = tag?.id;
const data = tag?.data;
const chip = Astro.props.chip ?? false;
---
{slug && data ? (
  <Link href={`/tags/${slug}`} chip={chip}
        class="font-mono text-xs uppercase tracking-wide text-neutral-400 hover:text-white">
      {data.name}
  </Link>
) : null}
</Link>
