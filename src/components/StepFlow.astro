---
export interface Props {
  steps: string[];
}

const { steps } = Astro.props;
---

<div class="step-flow not-prose my-6">
  <ol role="list" class="flow-list m-0 flex list-none flex-col p-0">
    {steps.map((step, index) => (
      <li class="flow-step m-0 flex min-w-0 flex-col items-center p-0">
        <span class="flow-label w-full border border-neutral-800 bg-tile px-3 py-3 text-center font-mono text-xs uppercase tracking-wide text-neutral-200">
          {step}
        </span>
        {index < steps.length - 1 && (
          <span aria-hidden="true" class="flow-arrow flex shrink-0 items-center justify-center text-neutral-500">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </span>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  .step-flow {
    container-type: inline-size;
  }

  .flow-arrow {
    width: 1.75rem;
    height: 1.75rem;
  }

  .flow-arrow svg {
    transform: rotate(90deg);
  }

  @container (min-width: 36rem) {
    .flow-list,
    .flow-step {
      flex-direction: row;
    }

    .flow-list {
      gap: 1.75rem;
      align-items: stretch;
    }

    .flow-step {
      position: relative;
      flex: 1 1 0%;
    }

    .flow-label {
      display: flex;
      min-width: 0;
      min-height: 3rem;
      height: 100%;
      align-items: center;
      justify-content: center;
      overflow-wrap: anywhere;
    }

    .flow-arrow {
      position: absolute;
      top: 50%;
      right: -1.75rem;
      transform: translateY(-50%);
    }

    .flow-arrow svg {
      transform: none;
    }
  }
</style>
