---
import RootLayout from "@/layouts/RootLayout.astro";
---
<RootLayout title="Not Found">
    <div class="flex min-h-[50vh] flex-col justify-center py-12">
        <p class="font-mono text-xs uppercase tracking-wide text-neutral-500">Error / Not found</p>
        <h1 class="font-mono mt-4 text-[clamp(96px,22vw,260px)] leading-none tracking-[-.06em] text-[#2a2a2a]">404</h1>
        <p class="mt-6 max-w-md text-lg text-neutral-400">Sorry, this page doesn't exist. There's plenty of other things to read though.</p>
        <div class="font-mono mt-8 flex gap-6 text-xs uppercase tracking-wide">
            <a href="/" class="text-white underline decoration-neutral-600 underline-offset-4 hover:decoration-white">Home</a>
            <a href="/blog" class="text-white underline decoration-neutral-600 underline-offset-4 hover:decoration-white">Blog</a>
        </div>
    </div>
</RootLayout>
