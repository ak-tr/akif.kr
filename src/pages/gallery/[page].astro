---
import { getCollection } from "astro:content";
import RootLayout from "@/layouts/RootLayout.astro";
import Gallery from "@/components/Gallery.astro";

export async function getStaticPaths() {
  const galleries = await getCollection("gallery");

  return galleries.map((gallery) => ({
    params: { page: gallery.id }, // note: from JSON data
    props: { gallery },
  }));
}

const { gallery: galleryData } = Astro.props;
const { data: gallery } = galleryData;
---

<RootLayout title={gallery.title}>
    <div class="grid gap-6 pb-12 pt-4 sm:grid-cols-[1fr_auto] sm:items-end">
        <h1 class="font-sans text-5xl font-light leading-[.9] tracking-[-.06em] sm:text-7xl">{gallery.title}</h1>
        <p class="font-mono text-xs uppercase tracking-wide text-neutral-500 sm:text-right">{gallery.images.length} photos</p>
    </div>
    <Gallery images={gallery.images} />
</RootLayout>
