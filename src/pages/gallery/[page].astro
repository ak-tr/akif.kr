---
import { getCollection } from "astro:content";
import RootLayout from "@/layouts/RootLayout.astro";
import Gallery from "@/components/Gallery.astro";

export async function getStaticPaths() {
  const galleries = await getCollection("gallery");

  return galleries.map((gallery) => ({
    params: { page: gallery.id }, // note: from JSON data
    props: { gallery },
  }));
}

const { gallery: galleryData } = Astro.props;
const { data: gallery } = galleryData;
---

<RootLayout title={gallery.title}>
    <h1 class="font-sans pb-10 pt-4 text-5xl font-light leading-[.9] tracking-[-.06em] sm:text-7xl">{gallery.title}</h1>
    <Gallery images={gallery.images} />
</RootLayout>
