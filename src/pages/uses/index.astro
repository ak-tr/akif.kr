---
import RootLayout from "@/layouts/RootLayout.astro";

interface Content {
  name: string;
  description: string;
  type?: string;
  url?: string;
}

const content: Record<string, Content[]> = {
  "Development": [
    { name: "Claude Code", type: "AI coding (Personal & Work)", description: "My go-to for agentic coding, both at home and at work. Lives in the terminal and gets real work done" },
    { name: "Cursor", type: "IDE (Work)", description: "Agentic IDE, nothing more to add here" },
    { name: "Ghostty", type: "terminal", description: "Go to terminal. Fast, native, and I love the way it looks" },
    { name: "Raycast", type: "productivity", description: "This isn't purely for development, but also for productivity, game changer" },
    { name: "Zen Browser", type: "browser", description: "Firefox based browser used for development at work" },
    { name: "Opera", type: "browser", description: "Browser used for mainly personal development and your average daily internet consumption" }
  ],
  "Devices": [
    { name: "2021 MacBook Pro M1 Pro", type: "laptop (personal)", description: "14”, 16GB RAM - fast, quiet, perfect (needs battery replacement though)" },
    { name: "2024 MacBook Pro M4 Pro", type: "laptop (work)", description: "16”, 24GB RAM - also fast, quiet, perfect but very heavy" },
    { name: "Microsoft Surface Laptop 5", type: "laptop (personal)", description: "13.5”, 16GB RAM - my Windows machine for the garage. Runs all the diagnostic software for my cars in VMs" },
    { name: "iPad Air (2022) 5th Gen", type: "tablet", description: "M1 chip, way more power than I need. Mostly for consuming content, but also has some of my BMW-specific apps for diagnostic use" },
  ],
  "PC Setup": [
    { name: "PC (Personal)", description: "Dan A4-H2O, Ryzen 7 5800X3D, RTX 3080, 32GB RAM - read more about it in my watercooling blog post", url: "/blog/my-first-custom-loop-sff-watercooling-dan-a4-h2o" },
    { name: "AOC Q27G41ZDF QD-OLED", type: "main monitor", description: "First OLED. Burn-in fears, but worth it all" },
    { name: "HUAWEI MateView GT 34-inch", type: "second monitor", description: "Ultrawide monitor, amazing for gaming, consuming content and development" },
    { name: "Womier SK71", type: "keyboard", description: "By far the best sounding fully pre-built mechanical keyboard at a very affordable price" },
    { name: "BenQ ZOWIE EC3-DW", type: "mouse", description: "Wireless, ergonomic and plug and play, no software needed. Fits my hand perfectly and just works" },
    { name: "duckyPad", type: "macropad", description: "Proud to say I own the pre-kickstarter version, great for macros, uses duckyscript" }
  ],
  "Workspace": [
    { name: "Herman Miller Aeron", type: "chair", description: "Pricey, but worth it after long hours, fully loaded" },
    { name: "MAIDeSITe Adjustable Height Standing Desk Frame", type: "standing desk frame", description: "Simply just a frame for an adjustable height desk setup" },
    { name: "IKEA LILLTRÄSK", type: "kitchen worktop", description: "The worktop I went for for my standing desk frame. Nice, somewhat thin, but still very sturdy" },
    { name: "IKEA ALEX", type: "drawers", description: "Alex drawers for storage on the left and right side of my standing desk" }
  ],
  "Audio": [
    { name: "Sennheiser IE 100 PRO", type: "iem", description: "Not used for very long, bought to replace my Simgot EW200" },
    { name: "FiiO KA11", type: "dongle dac & amp", description: "Dongle DAC and Amp, used with Sennheiser IE 100 PRO" },
    { name: "Steelseries Arctis Nova Pro Wireless", type: "headphones", description: "Used for gaming mostly, best battery system ever, alright sound" },
    { name: "Fifine K688", type: "microphone", description: "Budget microphone, used overhead in my setup, picks up sound quite well in close proximity, good sound" },
  ],
  "Cars": [
    { name: "2007 Vauxhall Astra VXR", type: "project", description: "Best sounding inline 4 to date, no debates about this one", url: "/gallery/vxr" },
    { name: "2007 BMW E91 335i Touring (Japanese Import)", type: "daily", description: "The notoriously unreliable N54, pray for me", url: "/gallery/e91" }
  ],
};
---

<RootLayout title="Uses">
  <div class="grid gap-6 pb-12 pt-4 sm:grid-cols-[1fr_auto] sm:items-end">
    <h1 class="font-sans text-6xl font-light leading-[.9] tracking-[-.06em] sm:text-8xl md:text-9xl">Uses</h1>
    <p class="max-w-xs text-sm text-neutral-500 sm:text-right">What's on my desk, in my dock, and in my stack (and more).</p>
  </div>
  {
    Object.entries(content).map(([category, items]) => (
      <section class="grid gap-4 border-t border-neutral-900 py-8 md:grid-cols-[200px_1fr] md:gap-8">
        <h2 class="font-mono text-xs uppercase tracking-wide text-neutral-500">{category} <span class="text-neutral-700">/ {String(items.length).padStart(2, '0')}</span></h2>
        <ul class="grid gap-[2px] sm:grid-cols-2">
          {
            items.map((details) => {
              const Wrapper = details.url ? 'a' : 'div';
              return (
                <li>
                  <Wrapper
                    href={details.url}
                    class:list={["flex h-full flex-col gap-2 bg-tile p-5", {"transition-colors hover:bg-invert hover:text-black group": details.url}]}
                  >
                    <div class="flex items-start justify-between gap-4">
                      <span class="font-medium">{details.name}</span>
                      {details.type && <span class="font-mono shrink-0 text-[10px] uppercase tracking-wide text-neutral-500">{details.type}</span>}
                    </div>
                    <p class="text-sm text-neutral-400 group-hover:text-neutral-600">{details.description}</p>
                    {details.url && <span class="font-mono mt-auto pt-2 text-[10px] uppercase tracking-wide">Read more →</span>}
                  </Wrapper>
                </li>
              );
            })
          }
        </ul>
      </section>
    ))
  }
</RootLayout>
