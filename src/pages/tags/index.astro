---
import {type CollectionEntry, getCollection} from "astro:content";

import RootLayout from "@/layouts/RootLayout.astro";
import { excludeDrafts } from "@/functions";

const posts = await getCollection('blog', excludeDrafts);

function tagCount(slug: CollectionEntry<'tags'>['id']) {
    return posts.filter((post) => post.data.tags.some((tag) => tag.id === slug)).length;
}

const tags = (await getCollection('tags'))
    .map((tag) => ({...tag, count: tagCount(tag.id)}))
    .sort((a, b) => b.count - a.count);
---
<RootLayout title="Tags">
    <div class="grid gap-6 pb-10 pt-4 sm:grid-cols-[1fr_auto] sm:items-end">
        <h1 class="font-sans text-6xl font-light leading-[.9] tracking-[-.06em] sm:text-8xl md:text-9xl">Tags</h1>
        <p class="font-mono text-xs text-neutral-500 sm:text-right">{tags.length} tags</p>
    </div>
    {!tags.length && <p class="font-mono text-neutral-500">No tags found.</p>}
    <div class="grid grid-cols-2 gap-[2px] sm:grid-cols-4">
        {tags.map(({id, data, count}, i) => (
            <a href={`/tags/${id}`} aria-label={`View posts tagged ${data.name}`}
               class:list={["group flex aspect-square flex-col justify-between p-4 transition-colors hover:bg-[#f2f2f2] hover:text-black sm:p-6",
                   i % 3 === 1 ? "bg-[#161616]" : i % 3 === 2 ? "bg-[#0c0c0c]" : "bg-[#111]"]}>
                <span class="font-mono text-[11px] uppercase tracking-wide opacity-60">{count} {count === 1 ? 'post' : 'posts'}</span>
                <span class="font-mono text-5xl leading-none tracking-[-.05em] text-[#2a2a2a] transition-colors group-hover:text-black sm:text-7xl">{String(count).padStart(2, '0')}</span>
                <span class="text-lg font-medium sm:text-xl">{data.name}</span>
            </a>
        ))}
    </div>
</RootLayout>
