---
import { type CollectionEntry, getCollection } from "astro:content";
import type { Page } from "astro";

import Mosaic from "../components/Mosaic.astro";
import Pagination from "../components/Pagination.astro";
import RootLayout from "./RootLayout.astro";

interface Props {
    title: string;
    description: string;
    page: Page<CollectionEntry<'blog'>>;
    robots?: string;
}

const {title, description, page, robots} = Astro.props;
const hasDefaultSlot = Astro.slots.has('default');
const tags = await getCollection('tags');
const years = page.data.map(({data}) => data.date.getFullYear());
---
<RootLayout {title} {description} {robots}>
    <div class="grid gap-6 pb-10 pt-4 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
            <h1 class="font-sans text-6xl font-light leading-[.9] tracking-[-.06em] sm:text-8xl md:text-9xl">
                {title}
            </h1>
            {hasDefaultSlot && (
                <div class="prose prose-invert mt-6 text-neutral-400">
                    <slot/>
                </div>
            )}
        </div>
        {page.total > 0 && (
            <p class="font-mono text-xs leading-relaxed text-neutral-500 sm:text-right">
                {page.total} {page.total === 1 ? 'post' : 'posts'}<br/>
                {Math.min(...years)} - {Math.max(...years)}
            </p>
        )}
    </div>
    <nav aria-label="Tags" class="font-mono mb-6 flex flex-wrap gap-x-5 gap-y-2 text-xs uppercase tracking-wide text-neutral-500">
        <a href="/blog/" class:list={["hover:text-white", {"text-white": Astro.url.pathname.startsWith('/blog')}]}>All</a>
        {tags.map(({id, data}) => (
            <a href={`/tags/${id}/`} class:list={["hover:text-white", {"text-white": Astro.url.pathname.startsWith(`/tags/${id}/`)}]}>{data.name}</a>
        ))}
    </nav>
    {page.data.length ? (
        <Mosaic posts={page.data} total={page.total} start={page.start}/>
    ) : (
        <p class="font-mono text-neutral-500">No posts found.</p>
    )}
    {(page.url.next || page.url.prev) && <Pagination page={page}/>}
</RootLayout>
