---
import SectionContainer from "../components/SectionContainer.astro";
import PageTitle from "../components/PageTitle.astro";
import RootLayout from "./RootLayout.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";
import Tag from "../components/Tag.astro";
import ScrollTop from "@/components/ScrollTop.astro";
import Share from "@/components/Share.astro";
import Mosaic from "@/components/Mosaic.astro";
import { SITE_METADATA } from "@/consts";
import { excludeDrafts, sortBlogPosts } from "@/functions";

import Hero from "@/components/Hero.astro"
import Collapsible from "@/components/Collapsible.astro";
import StepFlow from "@/components/StepFlow.astro";
import PostImage from "@/components/PostImage.astro";
import TLDR from "@/components/TLDR.astro";
import TLDRRow from "@/components/TLDRRow.astro";

export const components = { Hero, Collapsible, StepFlow, PostImage, TLDR, TLDRRow }

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const { Content, headings, remarkPluginFrontmatter } = await render(post);

const frontmatter = remarkPluginFrontmatter as {
	minutesRead: string;
	wordCount: number;
};

// Keep reading: the two posts sharing the most tags with this one, newest first on a tie. Numbers match the blog grid.
const posts = sortBlogPosts(await getCollection("blog", excludeDrafts));
const tagIds = post.data.tags.map((tag) => tag.id);
const sharedTags = (p: CollectionEntry<"blog">) => p.data.tags.filter((tag) => tagIds.includes(tag.id)).length;
const related = posts.filter((p) => p.id !== post.id).sort((a, b) => sharedTags(b) - sharedTags(a)).slice(0, 2);
const relatedNumbers = related.map((p) => posts.length - posts.indexOf(p));

const share = { url: new URL(`blog/${post.id}/`, SITE_METADATA.siteUrl).href, title: post.data.title, campaign: post.id };
---
<RootLayout
    title={post.data.title}
    description={post.data.summary}
    hero={post.data.hero}
    image={post.data.images}
    article={{ published: post.data.date, modified: post.data.lastmod, keywords: post.data.keywords }}
>
    <SectionContainer>
        <ScrollTop />
        <article class="mx-auto max-w-[680px]">
            <div>
                <header class="pt-6">
                    <a href="/blog/" class="font-mono text-xs uppercase tracking-wide text-neutral-500 hover:text-white">← Blog</a>
                    <p class="font-mono mt-16 flex flex-wrap gap-x-3 gap-y-1 text-xs uppercase tracking-wide text-neutral-500">
                        <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric'})}</time>
                        <span aria-hidden="true">/</span>
                        <span>{frontmatter.minutesRead}</span>
                        <span aria-hidden="true">/</span>
                        <span>{frontmatter.wordCount.toLocaleString('en-GB')} words</span>
                    </p>
                    <div class="mt-5"><PageTitle>{post.data.title}</PageTitle></div>
                    {post.data.summary && <p class="mt-7 font-sans text-xl leading-relaxed text-neutral-400">{post.data.summary}</p>}
                    <div class="mt-9 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex flex-wrap gap-2">
                            {post.data.tags.map((tag) => <Tag slug={tag.id} chip />)}
                        </div>
                        <Share {...share} variant="menu" />
                    </div>
                </header>
                <div class="pb-8">
                    <div
                        class="xl:row-span-2 xl:pb-0"
                    >
                        {
                            post.data.draft && (
                                <div class="font-mono border border-dashed border-neutral-700 p-4 mt-10 text-xs">
                                    <p class="text-neutral-400">
                                        This is a draft. It might be incomplete
                                        or have errors.
                                    </p>
                                </div>
                            )
                        }
                        <div
                            id="content"
                            data-wide-images
                            class="prose prose-lg max-w-none dark:prose-invert prose-h2:mt-20 prose-h2:text-[26px] [&_#hero]:my-12"
                        >
                            <slot />
                            {post.data.hero?.src && post.data.hero?.alt && <Hero src={post.data.hero.src} alt={post.data.hero.alt} />}
                            <Content components={{ ...components }} {headings} />
                        </div>
                        <Share {...share} variant="box" />
                    </div>
                </div>
            </div>
            {related.length > 0 && (
                <section aria-label="Keep reading" class="mt-16">
                    <div class="mb-4 flex justify-between font-mono text-xs uppercase tracking-wide text-neutral-500">
                        <span>Keep reading</span>
                        <a href="/blog/" class="text-neutral-400 hover:text-white">All {posts.length} posts →</a>
                    </div>
                    <Mosaic posts={related} numbers={relatedNumbers} pair />
                </section>
            )}
        </article>
    </SectionContainer>
</RootLayout>

<script src="/src/scripts/copyCode.ts"></script>

<script is:inline>
    function addIntersectionObserver() {
        const observer = new IntersectionObserver((sections) => {
            sections.forEach((section) => {
                const heading = section.target.querySelector("h2");
                if (!heading) return;
                const id = heading.getAttribute("id");

                // Get the link to this section's heading
                const link = document.querySelector(`nav ul li#${id}`);
                if (!link) return;

                // Add/remove the .active class based on whether the
                // section is visible
                const addRemove =
                    section.isIntersecting ? "add" : "remove";
                link.classList[addRemove]("border-black", "dark:font-extrabold", "dark:text-gray-50");
            });
        });

        document.querySelectorAll("section.heading").forEach((section) => {
            observer.observe(section);
        });
    }

    console.log("Adding interesction observer...");
    addIntersectionObserver();
</script>
